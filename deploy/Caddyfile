# DOMAIN comes from deploy/.env. Caddy fetches and renews the HTTPS cert itself.
# Without a domain yet, set DOMAIN=:80 to serve plain HTTP on the VM's IP.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	@static path /_next/static/* /img/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
