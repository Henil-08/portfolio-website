# Groq key for the terminal and team radio. Free tier is enough. https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile
GROQ_MODEL=
# Total radio answers per day across all visitors. Keeps you inside Groq's free limits.
RADIO_DAILY_CAP=800
# Public URL, used for metadata and the MCP install command
NEXT_PUBLIC_SITE_URL=https://example.com
# Domain Caddy should serve (deploy only). Use :80 if you have no domain yet.
DOMAIN=example.com
